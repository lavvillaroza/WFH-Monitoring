generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model configsettings {
  id        String @id
  name      String
  threshold Int
}

enum overtime_status {
  PENDING
  APPROVED
  REJECTED
}

enum dailytimerecordproblem_status {
  PENDING
  RESOLVED
}

enum user_role {
  ADMIN
  EMPLOYEE
}

enum leave_status {
  PENDING
  APPROVED
  REJECTED
}


model dailytimerecord {
  id         String    @id
  date       DateTime  @default(now())
  timeIn     DateTime
  timeOut    DateTime?
  duration   Int?
  remarks    String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime
  employeeId String
}

model dailytimerecordproblem {
  id         String    @id
  date       DateTime
  type       String
  remarks    String
  status     dailytimerecordproblem_status @default(PENDING)
  createdAt  DateTime                      @default(now())
  updatedAt  DateTime
  employeeId String
}

model employeedetails {
  id              String   @id
  name            String
  email           String   @unique(map: "EmployeeDetails_email_key")
  employeeId      String   @unique(map: "EmployeeDetails_employeeId_key")
  position        String
  department      String
  contactNumber   String?
  address         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime
  picture         Bytes?
  scheduleTimeIn  String?
  scheduleTimeOut String?
  activityStatus  String?
}

model humanactivitylog {
  id         String    @id
  activity   String
  start      DateTime
  end        DateTime?
  duration   Int?
  remarks    String?
  employeeId String
}

model leave {
  id         String       @id
  leaveType  String
  startDate  DateTime
  endDate    DateTime
  reason     String
  status     leave_status @default(PENDING)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime
  employeeId String
}

model overtime {
  id         String          @id
  startDate  DateTime
  endDate    DateTime
  reason     String
  status     overtime_status @default(PENDING)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime
  employeeId String
}

model screenshotmodel {
  id         String   @id
  employeeId String
  picture    Bytes?
  date       DateTime
}

model user {
  id         String    @id
  email      String    @unique(map: "User_email_key")
  employeeId String    @unique(map: "User_employeeId_key")
  password   String
  name       String
  role       user_role @default(EMPLOYEE)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime
  picture    Bytes?
  status     String
}

